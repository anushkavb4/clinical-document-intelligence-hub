# Copy to .env and fill in. Never commit .env.
# Free key (no card required): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini-3.6-flash is the default and what every measured figure in the README
# comes from.
#
# gemini-3.1-flash-lite is a working fallback if you exhaust the free-tier
# request allowance: ~4x faster, same NEWS2 decisions, but it fabricated 3 of
# 65 source quotes in testing. Use it to keep working, not to demo the audit
# trail.
GEMINI_MODEL=gemini-3.6-flash
